# Server-only environment variables. Never commit real values.
# Configure the web app in apps/web/.env.local or Vercel Production.
APP_URL=https://agent-session-atlas.vercel.app
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SECRET=
POSTGRES_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ZAI_API_KEY=
# Optional server-owned free-tier candidates. Only configured keys are used.
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
# 32-byte hexadecimal AES key. Generate once and preserve for saved BYOK keys.
BYOK_ENCRYPTION_KEY=
# Same value in Vercel and GitHub Actions repository secrets.
SCHEDULER_SECRET=
